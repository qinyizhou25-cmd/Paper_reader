# Copy this file to .env in the repository root, then fill in your own values.
# Real .env files are ignored by git.

# Optional default workspace used by paper-reader-app.ps1.
PAPER_READER_WORKSPACE=

# Choose one: kimi, siliconflow, deepseek.
PAPER_READER_LLM_PROVIDER=kimi

# Kimi / Moonshot. Either PAPER_READER_KIMI_API_KEY or MOONSHOT_API_KEY works.
PAPER_READER_KIMI_API_KEY=
PAPER_READER_KIMI_BASE_URL=https://api.moonshot.cn/v1
PAPER_READER_KIMI_MODEL=kimi-k2.6

# SiliconFlow.
PAPER_READER_SILICONFLOW_API_KEY=
PAPER_READER_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
PAPER_READER_LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# DeepSeek direct API.
PAPER_READER_DEEPSEEK_API_KEY=
PAPER_READER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
PAPER_READER_DEEPSEEK_MODEL=deepseek-chat

# Optional local translation settings.
PAPER_READER_TRANSLATION_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://127.0.0.1:11434

# Optional video/citation helpers.
PAPER_READER_YOUTUBE_API_KEY=
PAPER_READER_YOUTUBE_DAILY_LIMIT=90
PAPER_READER_YOUTUBE_MIN_SCORE=0.38

# Optional PDF converter override.
PAPER_READER_MINERU=

# Optional related-work mindmap import source.
PAPER_READER_RELATED_WORKS_MM=