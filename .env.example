# Copy this file to .env in the repository root, then fill in your own values.
# Configure it independently on each machine. Real .env files are ignored by git.
# Values are data, not shell commands: use absolute local paths, not $HOME or
# command substitutions. Quoted paths containing spaces/non-ASCII are supported.

# Optional default workspace used by the CLI and both platform launchers.
# Select an existing initialized library; reconnect a missing disk rather than
# creating an empty replacement. Use init deliberately for a NEW workspace.
# Windows example: C:\Users\you\Documents\Paper Library
# macOS example: /Users/you/Documents/Paper Library or /Volumes/Research/论文阅读
# Keep the selected paper data separate from this code checkout.
PAPER_READER_WORKSPACE=

# macOS interpreter selection happens BEFORE Python reads this file.
# For an override, export PAPER_READER_PYTHON="/absolute/path/to/python3" in the
# launching process, NOT here. Otherwise .venv/bin/python, then python3, is used.
# Recreate .venv on each machine; do not copy a Windows environment to macOS.

# Cloud AI features use Kimi / Moonshot-compatible APIs.
# Either PAPER_READER_KIMI_API_KEY or MOONSHOT_API_KEY works.
PAPER_READER_KIMI_API_KEY=
PAPER_READER_KIMI_BASE_URL=https://api.moonshot.cn/v1
PAPER_READER_KIMI_MODEL=kimi-k2.6
# Uploaded Kimi files are deleted after extraction by default.
# Set to 0, false, or no if you need to keep them in your Kimi file list.
PAPER_READER_KIMI_DELETE_FILES=1

# Optional local translation settings. Used when no Kimi key is configured.
PAPER_READER_TRANSLATION_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://127.0.0.1:11434

# Opt in to automatic, progressive translation on opening the reader.
# "legacy" preserves manual Kimi/Ollama translation; "copilot" uses only the
# configured loopback proxy, without silently falling back to another service.
PAPER_READER_TRANSLATION_PROVIDER=legacy
PAPER_READER_COPILOT_BASE_URL=http://127.0.0.1:4141/v1
PAPER_READER_COPILOT_MODEL=gpt-4.1
# Global in-flight request limit, not a per-paper multiplier (1-4).
PAPER_READER_TRANSLATION_CONCURRENCY=1
# Set up/authenticate/start the proxy separately on each machine. A loopback
# address points to THIS computer; the launcher does not start a proxy/Ollama.
# The proxy forwards paper text to its upstream service. It is not an offline
# model. Reading notes/highlights are never included in translation requests.

# Optional read-only mapping from the user's Feishu paper table.
# Use the resolved Base token and table ID, never a Wiki token.
PAPER_READER_FEISHU_BASE_TOKEN=
PAPER_READER_FEISHU_TABLE_ID=
PAPER_READER_FEISHU_AUTO_SYNC=0
# Native lark-cli executable; omit to discover a standard installation.
# Install/authenticate independently on each machine; keep login caches out of
# Git. On macOS use a native executable, never a copied Windows .cmd/.bat wrapper.
PAPER_READER_LARK_CLI=
# Explicit reading-record publication uses dedicated columns, never the
# existing Brief, AI-analysis or manual-note fields. Use exact field names;
# leave blank to use the default dedicated columns.
PAPER_READER_FEISHU_NOTES_FIELD=
PAPER_READER_FEISHU_DISCUSSIONS_FIELD=
PAPER_READER_FEISHU_DEFINITIONS_FIELD=
PAPER_READER_FEISHU_MATERIALS_FIELD=
PAPER_READER_FEISHU_BACKUP_FIELD=
# Legacy document publication only; the App now writes table cells and keeps
# existing archive documents and links unchanged.
PAPER_READER_FEISHU_ARCHIVE_FIELD=
PAPER_READER_FEISHU_ARCHIVE_PARENT=

# Optional video helpers. Either PAPER_READER_YOUTUBE_API_KEY or YOUTUBE_API_KEY works.
PAPER_READER_YOUTUBE_API_KEY=
YOUTUBE_API_KEY=
PAPER_READER_YOUTUBE_DAILY_LIMIT=90
PAPER_READER_YOUTUBE_MIN_SCORE=0.38

# Optional PDF converter override: use this machine's runnable MinerU executable.
# On macOS use an absolute native path, not a Windows .bat wrapper. Install its
# environment/models separately; requirements-pdf.txt only adds preview helpers.
PAPER_READER_MINERU=

# Optional related-work mindmap import source.
PAPER_READER_RELATED_WORKS_MM=