{
  "manifest_version": 3,
  "name": "Paper Reader Brief",
  "version": "0.1.0",
  "description": "Generate pre-Library Paper Briefs for PDFs and save candidates into Paper Reader Agent.",
  "permissions": ["activeTab", "cookies", "debugger", "downloads", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Paper Brief",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "options_page": "options.html"
}
